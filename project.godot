; Native desktop simulator framework.
config_version=5

[application]
config/name="Yard"
run/main_scene="res://native/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A native menu-driven simulation framework."
config/version="0.1.0"
config/icon="res://art/app-icon.svg"

[display]
window/size/viewport_width=1120
window/size/viewport_height=820
window/size/window_width_override=1120
window/size/window_height_override=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.965, 0.957, 0.925, 1)
