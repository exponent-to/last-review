; Native desktop simulator framework.
config_version=5

[application]
config/name="Last Review"
run/main_scene="res://native/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A software engineering life sim at the edge of automation."
config/version="0.2.0"
config/icon="res://art/app-icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.13, 1)
